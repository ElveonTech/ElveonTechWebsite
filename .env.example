# ============================================
# RESEND EMAIL CONFIGURATIE
# ============================================

# 1. Resend API Key (VERPLICHT)
# Haal deze op van: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# 2. Email Configuratie voor PRODUCTIE
# Gebruik deze zodra elveontech.nl is geverifieerd bij Resend
RESEND_FROM_EMAIL=ElveonTech <contact@elveontech.nl>
RESEND_TO_EMAIL=jurre@elveontech.nl

# ============================================
# TESTING MODE (alleen tijdens ontwikkeling)
# ============================================
# Als je het domein nog niet hebt geverifieerd,
# gebruik dan deze configuratie met het email-adres
# waarmee je bij Resend bent ingelogd:
#
# RESEND_FROM_EMAIL=ElveonTech Website <onboarding@resend.dev>
# RESEND_TO_EMAIL=jouw-resend-account@example.com
